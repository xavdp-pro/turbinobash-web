#!/bin/bash

#C# All $(app_list) $(tb mysql sudo/db/list)
#C# All db app
tb_getopt app=All type=All - $@

date=$(date +'%y-%m-%d-%HH%M')
d_sav1=/var/sav1/$(hostname)
mkdir -p $d_sav1/{auto,system}

backs_auto=7
backs_sytem=7

[ -e /etc/tb/backup ] && . /etc/tb/backup

# Convention: le dossier nosav est toujours exclu des backups
nosav="--exclude=./nosav"

# Une base non sauvegardee produit un .sql.bz2 qui se decompresse en zero
# octet. Le wrapper tb rendant toujours 0, c'est le fichier qu'il faut
# verifier : sans ce controle, une sauvegarde vide s'annonce « Done ».
function db_dump_check
{
	local f=$1 name=$2

	if [ "$(bzcat "$f" 2>/dev/null | head -c 100 | wc -c)" -eq 0 ]; then
		echoc -r1 "############## ECHEC $name DB — dump vide, sauvegarde inutilisable !" >&2
	fi

	# Toujours 0 : le wrapper tb tourne en « set -e », un retour non nul
	# interromprait la sauvegarde des applications suivantes. Le message est
	# le signal, puisque tb sort de toute facon avec 0.
	return 0
}

if [ "$app" = All ]; then
	for i in $(find $d_sav1/auto -maxdepth 1 -mindepth 1 -type d | sort | tac | sed $backs_auto',$!d'); do
		rm -rf $i
	done

	for i in $(find $d_sav1/system -maxdepth 1 -mindepth 1 -type d | sort | tac | sed $backs_sytem',$!d'); do
		rm -rf $i
	done

	date
	echo "############## SYSTEM ############## "

	dir=$d_sav1/system/$date
	mkdir -p $dir

	# Backup /etc
	echo "############## $dir/etc ##############"
	tar cjf $dir/etc.tar.bz2 -C /etc . | true

	# Backup /root : seulement les fichiers essentiels qui existent
	echo "############## $dir/root ##############"
	root_files=""
	for f in .ssh .bash_history .bashrc .bash_profile .profile .my.cnf .vimrc .gitconfig sav; do
		[ -e /root/$f ] && root_files="$root_files $f"
	done
	[ -n "$root_files" ] && tar cjf $dir/root.tar.bz2 -C /root $root_files | true
	echo

	date
	echo "############## ALL MYSQL ##############"
	for i in $(tb mysql sudo/db/list); do
		[ $i == performance_schema ] && continue
		[ $i == information_schema ] && continue

		dir=$d_sav1/auto/$date/$i
		echo "############## $dir"
		mkdir -p $dir

		tb mysql sudo/db/dump --triggers --routines $i | bzip2 >$dir/$i.sql.bz2
		db_dump_check $dir/$i.sql.bz2 $i
	done
	echo

	date
	echo "############## ALL APPs ##############"
	for app in $(app_list); do
		dir=$d_sav1/auto/$date/$app

		echo "############## $dir"

		mkdir -p $dir
		tar cjf $dir/$app.tar.bz2 $nosav -C /apps/$app .

		[ -e /var/spool/cron/crontabs/$app ] && cp -vf /var/spool/cron/crontabs/$app $dir/crontab

	done

	date
	for i in $(app_list) $(tb mysql sudo/db/list); do
		du -sh $d_sav1/auto/$date/$i
	done
	date
	echo
else
	dir=$d_sav1/manual/$app/$date
	mkdir -p $dir

	if [[ "$type" = "All" || "$type" = "app" ]]; then
		echo "############## MANUAL $app APP $dir/$app.tar.bz2"
		tar cjf $dir/$app.tar.bz2 $nosav -C /apps/$app .
		[ -e /var/spool/cron/crontabs/$app ] && cp -vf /var/spool/cron/crontabs/$app $dir/crontab
	fi

	if [[ "$type" = "All" || "$type" = "db" ]]; then
		echo "############## MANUAL $app DB $dir/$app.sql.bz2"
		tb mysql sudo/db/dump --triggers --routines $app | bzip2 >$dir/$app.sql.bz2
		db_dump_check $dir/$app.sql.bz2 $app
	fi

	echo
	echo "############## Done"
fi
